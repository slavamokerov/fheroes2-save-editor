# Translations for the fheroes2 Save Editor itself (not the game texts).
# The game texts come from fheroes2's own <lang>.mo files.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "%1  —  month %2, week %3, day %4  (format %5)"
msgstr "%1 — Monat %2, Woche %3, Tag %4 (Format %5)"

msgid "Artifacts unavailable (hero record not recognized)"
msgstr "Artefakte nicht verfügbar (Heldeneintrag nicht erkannt)"

msgid "Cheat activated: +5 Black Dragons (slot %1)."
msgstr "Cheat aktiviert: +5 Schwarze Drachen (Platz %1)."

msgid "Choose the game data folder (HEROES2.AGG)"
msgstr "Ordner mit den Spieldaten wählen (HEROES2.AGG)"

msgid "Default name length mismatch — reset unavailable"
msgstr "Länge des Standardnamens stimmt nicht überein — Zurücksetzen nicht verfügbar"

msgid "Failed to load game resources"
msgstr "Spielressourcen konnten nicht geladen werden"

msgid "fheroes2 saves (*.sav *.savc *.savm *.savh);;All files (*)"
msgstr "fheroes2-Spielstände (*.sav *.savc *.savm *.savh);;Alle Dateien (*)"

msgid "Fill the previous artifact slots first"
msgstr "Zuerst die vorherigen Artefaktplätze füllen"

msgid "Fill the previous skill slots first"
msgstr "Zuerst die vorherigen Fertigkeitsplätze füllen"

msgid "Game graphics not found — press GAME DATA and choose the folder with HEROES2.AGG."
msgstr "Spielgrafik nicht gefunden — SPIELDATEN drücken und den Ordner mit HEROES2.AGG wählen."

msgid "Game resources loaded from %1"
msgstr "Spielressourcen geladen aus %1"

msgid "Hero #%1"
msgstr "Held #%1"

msgid "Hero name"
msgstr "Name des Helden"

msgid "Open fheroes2 save"
msgstr "fheroes2-Spielstand öffnen"

msgid "Primary skills unavailable (hero record not recognized)"
msgstr "Primärfertigkeiten nicht verfügbar (Heldeneintrag nicht erkannt)"

msgid "Saved: %1 (backup: .bak)"
msgstr "Gespeichert: %1 (Sicherung: .bak)"

msgid "Set hero's Secondary Skills. Right-click to remove skill."
msgstr "Sekundärfertigkeiten des Helden wählen. Rechtsklick — Fertigkeit entfernen."

msgid "Spell book unavailable (hero record not recognized)"
msgstr "Zauberbuch nicht verfügbar (Heldeneintrag nicht erkannt)"

msgid "Spell points unavailable (hero record not recognized)"
msgstr "Zauberpunkte nicht verfügbar (Heldeneintrag nicht erkannt)"

msgid "The chosen folder has no HEROES2.AGG"
msgstr "Der gewählte Ordner enthält keine HEROES2.AGG"

msgid "The last hero's troop cannot be removed"
msgstr "Der letzte Trupp des Helden kann nicht entfernt werden"

msgid "The name must be the same length (%1 character(s)) to avoid shifting the save data."
msgstr "Der Name muss dieselbe Länge haben (%1 Zeichen), sonst verschieben sich die Spielstandsdaten."

msgid "There are unsaved changes. Open another file without saving?"
msgstr "Es gibt ungespeicherte Änderungen. Andere Datei ohne Speichern öffnen?"

msgid "This save has no heroes with an assigned color."
msgstr "Dieser Spielstand hat keine Helden mit zugewiesener Farbe."

msgid "Warning: fheroes2 is running — AUTOSAVE may overwrite your changes!"
msgstr "Warnung: fheroes2 läuft — AUTOSAVE kann Ihre Änderungen überschreiben!"

msgid "OPEN SAVE..."
msgstr "SPIELSTAND ÖFFNEN..."

msgid "GAME DATA..."
msgstr "SPIELDATEN..."

msgid "Very Slow"
msgstr "Sehr langsam"

msgid "Average"
msgstr "Mittel"

msgid "Ultra Fast"
msgstr "Extrem schnell"

