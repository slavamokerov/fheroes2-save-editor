# Translations for the fheroes2 Save Editor itself (not the game texts).
# The game texts come from fheroes2's own <lang>.mo files.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "%1  —  month %2, week %3, day %4  (format %5)"
msgstr "%1 — måned %2, uke %3, dag %4 (format %5)"

msgid "Artifacts unavailable (hero record not recognized)"
msgstr "Artefakter utilgjengelige (heltens post ble ikke gjenkjent)"

msgid "Cheat activated: +5 Black Dragons (slot %1)."
msgstr "Juksekode aktivert: +5 svarte drager (plass %1)."

msgid "Choose the game data folder (HEROES2.AGG)"
msgstr "Velg mappen med spilldata (HEROES2.AGG)"

msgid "Default name length mismatch — reset unavailable"
msgstr "Lengden på standardnavnet stemmer ikke — tilbakestilling utilgjengelig"

msgid "Failed to load game resources"
msgstr "Kunne ikke laste inn spillets ressurser"

msgid "fheroes2 saves (*.sav *.savc *.savm *.savh);;All files (*)"
msgstr "fheroes2-lagringer (*.sav *.savc *.savm *.savh);;Alle filer (*)"

msgid "Fill the previous artifact slots first"
msgstr "Fyll de foregående artefaktplassene først"

msgid "Fill the previous skill slots first"
msgstr "Fyll de foregående ferdighetsplassene først"

msgid "Game graphics not found — press GAME DATA and choose the folder with HEROES2.AGG."
msgstr "Spillets grafikk ikke funnet — trykk SPILLDATA og velg mappen med HEROES2.AGG."

msgid "Game resources loaded from %1"
msgstr "Spillets ressurser lastet fra %1"

msgid "Hero #%1"
msgstr "Helt #%1"

msgid "Hero name"
msgstr "Heltens navn"

msgid "Open fheroes2 save"
msgstr "Åpne fheroes2-lagring"

msgid "Primary skills unavailable (hero record not recognized)"
msgstr "Primærferdigheter utilgjengelige (heltens post ble ikke gjenkjent)"

msgid "Saved: %1 (backup: .bak)"
msgstr "Lagret: %1 (sikkerhetskopi: .bak)"

msgid "Set hero's Secondary Skills. Right-click to remove skill."
msgstr "Velg heltens sekundærferdigheter. Høyreklikk — fjern ferdighet."

msgid "Spell book unavailable (hero record not recognized)"
msgstr "Trylleboken utilgjengelig (heltens post ble ikke gjenkjent)"

msgid "Spell points unavailable (hero record not recognized)"
msgstr "Tryllepoeng utilgjengelige (heltens post ble ikke gjenkjent)"

msgid "The chosen folder has no HEROES2.AGG"
msgstr "Den valgte mappen har ingen HEROES2.AGG"

msgid "The last hero's troop cannot be removed"
msgstr "Heltens siste tropp kan ikke fjernes"

msgid "The name must be the same length (%1 character(s)) to avoid shifting the save data."
msgstr "Navnet må ha samme lengde (%1 tegn) for ikke å forskyve lagringsdataene."

msgid "There are unsaved changes. Open another file without saving?"
msgstr "Det er ulagrede endringer. Åpne en annen fil uten å lagre?"

msgid "This save has no heroes with an assigned color."
msgstr "Denne lagringen har ingen helter med tildelt farge."

msgid "Warning: fheroes2 is running — AUTOSAVE may overwrite your changes!"
msgstr "Advarsel: fheroes2 kjører — AUTOSAVE kan overskrive endringene dine!"

msgid "OPEN SAVE..."
msgstr "ÅPNE LAGRING..."

msgid "GAME DATA..."
msgstr "SPILLDATA..."

msgid "Very Slow"
msgstr "Svært langsom"

msgid "Average"
msgstr "Gjennomsnittlig"

msgid "Ultra Fast"
msgstr "Ultra rask"

