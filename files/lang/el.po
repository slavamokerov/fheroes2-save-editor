# Translations for the fheroes2 Save Editor itself (not the game texts).
# The game texts come from fheroes2's own <lang>.mo files.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "%1  —  month %2, week %3, day %4  (format %5)"
msgstr "%1 — μήνας %2, εβδομάδα %3, ημέρα %4 (μορφή %5)"

msgid "Artifacts unavailable (hero record not recognized)"
msgstr "Τα τεχνουργήματα δεν είναι διαθέσιμα (η εγγραφή του ήρωα δεν αναγνωρίστηκε)"

msgid "Cheat activated: +5 Black Dragons (slot %1)."
msgstr "Ενεργοποιήθηκε cheat: +5 Μαύροι Δράκοι (θέση %1)."

msgid "Choose the game data folder (HEROES2.AGG)"
msgstr "Επιλέξτε τον φάκελο με τα δεδομένα του παιχνιδιού (HEROES2.AGG)"

msgid "Default name length mismatch — reset unavailable"
msgstr "Το μήκος του προεπιλεγμένου ονόματος δεν ταιριάζει — η επαναφορά δεν είναι διαθέσιμη"

msgid "Failed to load game resources"
msgstr "Αποτυχία φόρτωσης των πόρων του παιχνιδιού"

msgid "fheroes2 saves (*.sav *.savc *.savm *.savh);;All files (*)"
msgstr "Αποθηκεύσεις fheroes2 (*.sav *.savc *.savm *.savh);;Όλα τα αρχεία (*)"

msgid "Fill the previous artifact slots first"
msgstr "Συμπληρώστε πρώτα τις προηγούμενες θέσεις τεχνουργημάτων"

msgid "Fill the previous skill slots first"
msgstr "Συμπληρώστε πρώτα τις προηγούμενες θέσεις δεξιοτήτων"

msgid "Game graphics not found — press GAME DATA and choose the folder with HEROES2.AGG."
msgstr "Δεν βρέθηκαν τα γραφικά του παιχνιδιού — πατήστε ΔΕΔΟΜΕΝΑ ΠΑΙΧΝΙΔΙΟΥ και επιλέξτε τον φάκελο με το HEROES2.AGG."

msgid "Game resources loaded from %1"
msgstr "Οι πόροι του παιχνιδιού φορτώθηκαν από %1"

msgid "Hero #%1"
msgstr "Ήρωας #%1"

msgid "Hero name"
msgstr "Όνομα ήρωα"

msgid "Open fheroes2 save"
msgstr "Άνοιγμα αποθήκευσης fheroes2"

msgid "Primary skills unavailable (hero record not recognized)"
msgstr "Οι κύριες δεξιότητες δεν είναι διαθέσιμες (η εγγραφή του ήρωα δεν αναγνωρίστηκε)"

msgid "Saved: %1 (backup: .bak)"
msgstr "Αποθηκεύτηκε: %1 (αντίγραφο ασφαλείας: .bak)"

msgid "Set hero's Secondary Skills. Right-click to remove skill."
msgstr "Επιλέξτε τις δευτερεύουσες δεξιότητες του ήρωα. Δεξί κλικ — αφαίρεση δεξιότητας."

msgid "Spell book unavailable (hero record not recognized)"
msgstr "Το βιβλίο ξορκιών δεν είναι διαθέσιμο (η εγγραφή του ήρωα δεν αναγνωρίστηκε)"

msgid "Spell points unavailable (hero record not recognized)"
msgstr "Οι πόντοι ξορκιών δεν είναι διαθέσιμοι (η εγγραφή του ήρωα δεν αναγνωρίστηκε)"

msgid "The chosen folder has no HEROES2.AGG"
msgstr "Ο επιλεγμένος φάκελος δεν περιέχει HEROES2.AGG"

msgid "The last hero's troop cannot be removed"
msgstr "Το τελευταίο στράτευμα του ήρωα δεν μπορεί να αφαιρεθεί"

msgid "The name must be the same length (%1 character(s)) to avoid shifting the save data."
msgstr "Το όνομα πρέπει να έχει το ίδιο μήκος (%1 χαρακτήρες) για να μη μετατοπιστούν τα δεδομένα."

msgid "There are unsaved changes. Open another file without saving?"
msgstr "Υπάρχουν μη αποθηκευμένες αλλαγές. Να ανοίξει άλλο αρχείο χωρίς αποθήκευση;"

msgid "This save has no heroes with an assigned color."
msgstr "Αυτή η αποθήκευση δεν έχει ήρωες με εκχωρημένο χρώμα."

msgid "Warning: fheroes2 is running — AUTOSAVE may overwrite your changes!"
msgstr "Προσοχή: το fheroes2 εκτελείται — το AUTOSAVE μπορεί να αντικαταστήσει τις αλλαγές σας!"

msgid "OPEN SAVE..."
msgstr "ΑΝΟΙΓΜΑ ΑΠΟΘΗΚΕΥΣΗΣ..."

msgid "GAME DATA..."
msgstr "ΔΕΔΟΜΕΝΑ ΠΑΙΧΝΙΔΙΟΥ..."

msgid "Very Slow"
msgstr "Πολύ αργή"

msgid "Average"
msgstr "Μέση"

msgid "Ultra Fast"
msgstr "Εξαιρετικά γρήγορη"

